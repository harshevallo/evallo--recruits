# Evallo Recruit — web environment
# Copy to .env. NEVER put a secret here: everything VITE_-prefixed is shipped
# in the browser bundle and readable by anyone (08_SETUP_GUIDE.md §3).

# Must match PORT in apps/api/.env (the web dev server itself runs on 3001, pinned
# in vite.config.js).
VITE_API_BASE_URL=http://localhost:8081/api

# ── Google Sign-In ────────────────────────────────────────────────────────────
# A Google OAuth client id is PUBLIC by design — it identifies the app to Google,
# it is not a secret. When unset, the Google button renders disabled and email
# auth works normally. Must match GOOGLE_CLIENT_ID in apps/api/.env.
VITE_GOOGLE_CLIENT_ID=

# ── Homepage "Teaching Sample" video ───────────────────────────────────────────
# A YouTube or Vimeo URL for the sample clip on the landing page. Those two hosts
# only — the embed allow-list rejects anything else and the card falls back to a
# plain illustration. Unlisted YouTube works and is usually what you want.
# When unset, the card renders with NO play button rather than a dead one.
VITE_MARKETING_SAMPLE_VIDEO_URL=
