# Evallo Recruit — API environment
# Copy to .env and fill in. NEVER commit .env (08_SETUP_GUIDE.md §3).

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8081

# ── Database ──────────────────────────────────────────────────────────────────
# MUST target the `evallo-recruit` database — the `evallo` database belongs to the
# main Evallo platform and is out of scope for this project.
# (authSource only selects where credentials are checked; it does not change where
# application data is stored.)
# A replica set is required for multi-document transactions (05_DATABASE_SCHEMA.md §11);
# a standalone server runs fine but silently lacks them.
MONGODB_CLOUD=mongodb://user:pass@host:27017/evallo-recruit?directConnection=true&authSource=admin

# ── CORS ──────────────────────────────────────────────────────────────────────
# Exact origin, or a comma-separated list of exact origins (apex + www, a preview
# domain). A wildcard is rejected at boot: it is incompatible with credentials:true,
# which the refresh-token cookie requires (ADR-005).
CLIENT_ORIGIN=http://localhost:3001

# Public URL of the web app — used to build verification and reset links.
APP_URL=http://localhost:3001

# ── Refresh cookie / deployment topology (ADR-005, TRD §13) ───────────────────
# The origin the BROWSER uses to reach this API, e.g. https://api.evallo.in. Optional,
# and used only to decide the refresh cookie's SameSite:
#
#   same site (app.evallo.in → api.evallo.in)   SameSite=Lax   — the stronger default
#   cross site (vercel.app → onrender.com)      SameSite=None; Secure — required, or the
#                                               browser never sends the cookie and every
#                                               user is signed out when the access token
#                                               expires 15 minutes after sign-in
#
# Leave blank and the cookie stays SameSite=Lax, which is correct ONLY if the API and the
# web app share a registrable domain. `GET /api/health` reports what was resolved.
# In production the server refuses to boot if this resolves to SameSite=None over http.
# API_PUBLIC_URL=http://localhost:8081

# Overrides. `auto` (default) derives SameSite from CLIENT_ORIGIN vs API_PUBLIC_URL.
# COOKIE_SAMESITE=auto
# COOKIE_SECURE=

# ── Background jobs (src/jobs/) ───────────────────────────────────────────────
# Always disabled under NODE_ENV=test.
# JOBS_ENABLED=true
#
# Account deletion needs BOTH switches before anything is destroyed (16_RETENTION_POLICY.md §5).
# Both are DELIBERATELY off: the retention policy is a founder/legal decision that is still
# awaiting sign-off (PRD §16.1, backlog B-09, 12_KNOWN_ISSUES.md I-17).
#
#   period unset          -> nothing is ever eligible; the job reports only
#   period set, purge off -> the job reports exactly which accounts WOULD be processed
#   both set              -> eligible accounts are purged per 16_RETENTION_POLICY.md §3
#
# Recommended rollout: set the period, read a cycle or two of reports, then arm the purge.
# ACCOUNT_DELETION_RETENTION_DAYS=30
# ACCOUNT_DELETION_PURGE_ENABLED=false
# ACCOUNT_DELETION_BATCH_SIZE=100

# Retention for pre-account marketing leads (TD-06) and for the IP/user-agent fields on audit
# events. Unset = kept indefinitely, which is the current state. The audit EVENT is always kept —
# only the network identifiers age out (PRD §16.1 requires the trail to survive).
# EARLY_ACCESS_RETENTION_DAYS=730
# AUDIT_IP_RETENTION_DAYS=365

# ── JWT (ADR-005) ─────────────────────────────────────────────────────────────
# Two DIFFERENT long random strings, so a leaked access secret cannot forge refresh
# tokens. Optional in development (a fixed dev fallback is used); REQUIRED in
# production — the server refuses to boot without them.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Email ─────────────────────────────────────────────────────────────────────
# console  = print the message + link to the API console (works offline; the dev default)
# smtp     = send via nodemailer using the EMAIL_* settings below
# sendgrid = the same SMTP transport pointed at SendGrid; clearer intent
#
# NODE_ENV=test always forces the console transport, so tests never send real mail.
# If a provider is requested but the EMAIL_* settings are incomplete, the API logs a
# warning and falls back to console rather than failing at send time.
MAIL_PROVIDER=console
MAIL_FROM=Evallo Recruit <no-reply@evallo.local>

# SMTP settings. EMAIL_* is the primary naming; SMTP_* is accepted as an alias.
# For SendGrid: EMAIL_HOST=smtp.sendgrid.net, EMAIL_USER=apikey, EMAIL_PASS=<your API key>.
# EMAIL_SECURE is inferred from port 465 when unset. NEVER commit a real key.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_SECURE=
# EMAIL_SENDER=

# ── Google Sign-In (identity only) ────────────────────────────────────────────
# The Google ID token is verified then discarded; our own JWT is always issued.
# When unset, the Google button renders disabled and email auth still works.
# Must match VITE_GOOGLE_CLIENT_ID in apps/web/.env.
GOOGLE_CLIENT_ID=
# Accepted but NOT used: verifying an ID token needs only the client id and Google's
# public keys. A SPA never performs a code exchange, so no secret is involved.
GOOGLE_CLIENT_SECRET=
